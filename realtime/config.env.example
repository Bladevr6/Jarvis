# Copier ce fichier en config.env puis remplir les clés.
# cp config.env.example config.env && nano config.env

# --- OpenAI Realtime ---
OPENAI_API_KEY=sk-...
# gpt-realtime (comprend bien le français, recommandé) ou gpt-realtime-mini (~3x moins cher, comprend mal)
REALTIME_MODEL=gpt-realtime
# Voix : cedar, marin, echo, ash, ballad, coral, sage, verse, alloy, shimmer
VOICE=cedar

# --- Home Assistant ---
HA_URL=http://127.0.0.1:8123
HA_TOKEN=colle_ici_le_jeton_longue_duree

# --- Fonctions ---
# Clé Anthropic pour « demander à Claude » (questions complexes, recherche web). Vide = outil désactivé.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Entité météo (vide = première weather.* trouvée)
WEATHER_ENTITY=
# Echos visés par « partout » (morceaux de noms de services notify.alexa_media_*)
ALEXA_ECHOS=bureau,echo_salon,echo_spot,mia
# Agendas (vide = tous les calendar.* de HA), séparés par des virgules
CALENDAR_ENTITIES=
MAIL_ENTITY=input_text.dernier_mail
TTS_ENTITY=tts.openai_tts_jarvis
SONOS_ENTITY=media_player.sonos_sonos

# --- Audio ---
MIC_DEVICE=plughw:2,0
# Amplification numérique du micro (1 = aucune). Le ReSpeaker sort un signal faible.
MIC_GAIN=2.5
# Canal du ReSpeaker : mono (mélange), 0 ou 1 (le XVF3800 sort un canal « conférence » et un canal « ASR »).
# Tester avec : python3 wake.py 0   puis   python3 wake.py 1
MIC_CHANNEL=mono
# Sortie son : voir "aplay -l".
#   plughw:2,0  = prise jack du ReSpeaker (recommandé, permet d'interrompre Jarvis)
#   plughw:1,0  = prise jack du Pi
#   sonos:media_player.sonos_sonos = mode temporaire via Home Assistant (1-3 s de délai, pas d'interruption)
SPEAKER_DEVICE=plughw:2,0
# 1 = bip à la détection du mot d'activation
BEEP=1
# 0 = micro coupé pendant que Jarvis parle (sûr sans annulation d'écho)
# 1 = on peut interrompre Jarvis (nécessite annulation d'écho, ex. HP branché sur le ReSpeaker)
BARGE_IN=0

# --- Mot d'activation ---
# local   = détection dans le script (onnxruntime), recommandé
# wyoming = conteneur Docker openwakeword (WAKE_HOST/WAKE_PORT)
WAKE_MODE=local
WAKE_WORD=hey_jarvis
# Seuil de détection local : 0.5 par défaut ; baisser (0.35) si Jarvis n'entend pas, monter s'il se déclenche à tort
WAKE_THRESHOLD=0.45
# Nombre d'analyses consécutives (80 ms chacune) au-dessus du seuil : 2 limite les fausses détections en conversation
WAKE_PATIENCE=2
WAKE_HOST=127.0.0.1
WAKE_PORT=10400
# Mode wyoming : commande lancée au démarrage et à chaque reconnexion. Vide = rien.
WAKE_RESTART_CMD=

# --- Durées (secondes) ---
# Fausse détection : on raccroche si personne ne parle dans ce délai
FIRST_SPEECH_TIMEOUT=6
# Fin de conversation après ce silence
IDLE_TIMEOUT=8
# Durée max d'une session (protection du budget)
MAX_SESSION=300
# Silence (ms) qui marque la fin de votre phrase
VAD_SILENCE_MS=500

LOG_LEVEL=INFO
