[Unit]
Description=Jarvis Realtime (mot d'activation + OpenAI Realtime)
After=network-online.target docker.service
Wants=network-online.target
Conflicts=wyoming-satellite.service

[Service]
User=jarvis
WorkingDirectory=/home/jarvis/jarvis/realtime
ExecStart=/usr/bin/python3 -u /home/jarvis/jarvis/realtime/jarvis.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
